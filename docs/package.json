{
  "name": "unschema-graph-docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:compatibility": "node scripts/check-compatibility-docs.mjs",
    "check:markdown": "node scripts/check-markdown-output.mjs",
    "check:recipes": "node scripts/validate-recipe-examples.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "generate:builders": "node scripts/generate-builder-pages.mjs",
    "generate:recipes": "node scripts/generate-recipes.mjs",
    "generate:llms": "node scripts/generate-llms-txt.mjs",
    "predev": "pnpm run generate:builders && pnpm run generate:recipes && pnpm run generate:llms",
    "dev": "astro dev --base /",
    "prestart": "pnpm run generate:builders && pnpm run generate:recipes && pnpm run generate:llms",
    "start": "astro dev --base /",
    "prebuild": "pnpm run generate:builders && pnpm run generate:recipes && pnpm run check:recipes && pnpm run check:compatibility && pnpm run generate:llms",
    "build": "astro build",
    "postbuild": "pnpm run check:links",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.4",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/commit-mono": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@unschema-graph/astro": "workspace:*",
    "@unschema-graph/core": "workspace:*",
    "@unschema-graph/svelte": "workspace:*",
    "astro": "^7.2.10",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
