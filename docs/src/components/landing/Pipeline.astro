---
import type { LandingCopy } from '../../data/landing';
import SectionHeader from './SectionHeader.astro';

interface Props {
  copy: LandingCopy['pipeline'];
}

const { copy } = Astro.props;
---

<section aria-labelledby="pipeline-title">
  <SectionHeader id="pipeline-title" title={copy.title} subtitle={copy.subtitle} />
  <ol class="steps">
    {copy.steps.map((step) => (
  <li>
    <span class="number">{step.number}</span>
    <h3>{step.name}</h3>
    <code>{step.snippet}</code>
    <p>{step.description}</p>
  </li>
))}
  </ol>
</section>

<style>
section {
  padding-block: clamp(3.5rem, 7vw, 5.5rem);
  border-bottom: var(--ug-border);
}

.steps {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
  margin: 0;
  padding: 0;
  border-top: 1px solid var(--ug-line);
  list-style: none;
}

li {
  min-width: 0;
  padding: 1.4rem 1.25rem 0 0;
}

li + li {
  padding-left: 1.25rem;
  border-left: 1px solid var(--ug-line);
}

.number {
  display: block;
  margin-bottom: 0.65rem;
  color: var(--ug-violet-strong);
  font-family: var(--ug-font-mono);
  font-size: 0.78rem;
  font-weight: 650;
}

h3 {
  margin: 0 0 0.85rem;
  color: var(--ug-graphite);
  font-size: 1.05rem;
}

code {
  display: block;
  min-width: 0;
  margin-bottom: 0.9rem;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--ug-graphite);
  font-size: 0.78rem;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

p {
  margin: 0;
  color: var(--ug-muted);
  font-size: 0.9rem;
  line-height: 1.55;
}

@media (max-width: 60rem) {
  .steps {
    grid-template-columns: 1fr 1fr;
  }

  li:nth-child(3) {
    padding-left: 0;
    border-left: 0;
  }

  li:nth-child(n + 3) {
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--ug-line);
  }
}

@media (max-width: 38rem) {
  .steps {
    grid-template-columns: 1fr;
  }

  li,
  li + li,
  li:nth-child(3) {
    margin: 0;
    padding: 1.35rem 0;
    border-right: 0;
    border-bottom: 1px solid var(--ug-line);
    border-left: 0;
  }
}
</style>
