---
import type { LandingCopy, LandingLocale } from '../../data/landing';
import BrandMark from '../BrandMark.astro';

interface Props {
  copy: LandingCopy['cta'];
  locale: LandingLocale;
}

const { copy, locale } = Astro.props;
const localPath = (path: string) => (locale === 'fr' ? `/fr${path}` : path);
---

<section aria-labelledby="cta-title">
  <div class="copy">
    <div class="brand"><BrandMark size={20} /><span>unschema-graph</span></div>
    <h2 id="cta-title">{copy.title}</h2>
    <p>{copy.subtitle}</p>
  </div>
  <div class="actions">
    <a class="primary" href={localPath('/getting-started/overview/')}>{copy.primaryButton}</a>
    <a
      class="secondary"
      href="https://github.com/johanldx/unschema-graph"
      target="_blank"
      rel="noopener noreferrer"
      >{copy.secondaryButton}</a
    >
  </div>
</section>

<style>
section {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 3rem;
  align-items: end;
  margin-block: clamp(3.5rem, 7vw, 5.5rem) 1.5rem;
  padding: clamp(2rem, 4vw, 3rem);
  border-radius: var(--ug-radius-md);
  background: var(--ug-aubergine-deep);
  color: var(--ug-aubergine-paper);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
  color: #d4c8fc;
  font-size: 0.85rem;
  font-weight: 700;
}

h2 {
  max-width: 22ch;
  margin: 0 0 0.75rem;
  color: white;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 750;
  letter-spacing: -0.04em;
  line-height: 1.08;
  text-wrap: balance;
}

p {
  max-width: 42rem;
  margin: 0;
  color: #c9c1df;
  font-size: 0.98rem;
  line-height: 1.6;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  justify-content: flex-end;
}

.actions a {
  display: inline-flex;
  min-height: 2.8rem;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding-inline: 1.1rem;
  border: 1px solid transparent;
  border-radius: var(--ug-radius-sm);
  font-size: 0.92rem;
  font-weight: 650;
  text-decoration: none;
}

.primary {
  background: var(--ug-violet);
  color: white;
}

.primary:hover {
  background: var(--ug-violet-soft);
}

.actions .secondary {
  border-color: color-mix(in srgb, white 22%, transparent);
  color: #f1edfe;
}

.actions .secondary:hover {
  border-color: white;
}

@media (max-width: 54rem) {
  section {
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: start;
  }

  .actions {
    justify-content: flex-start;
  }
}

@media (max-width: 36rem) {
  .actions a {
    width: 100%;
  }
}
</style>
