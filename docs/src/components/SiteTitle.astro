---
import BrandMark from './BrandMark.astro';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="brand" aria-label="unschema-graph — Documentation">
  <BrandMark size={34} />
  <span translate="no">unschema<span>-graph</span></span>
</a>
<style>
.brand {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  color: var(--ug-graphite);
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: -0.025em;
  text-decoration: none;
  white-space: nowrap;
}
.brand span span {
  color: var(--ug-violet-strong);
}
</style>
