---
const isFrench = Astro.url.pathname.startsWith('/fr');
const label = isFrench ? 'Copier la page en Markdown' : 'Copy page as Markdown';
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const path =
  normalizedPath === '/'
    ? '/index.md'
    : normalizedPath === '/fr'
      ? '/fr/index.md'
      : `${normalizedPath}.md`;
---

<div class="page-actions">
  <button type="button" class="copy-button" data-copy-markdown data-markdown-path={path}>
    <svg
      class="copy-icon"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
    </svg>
    <svg
      class="check-icon"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
    <span class="btn-text">{label}</span>
  </button>
</div>

<script>
document.querySelectorAll<HTMLButtonElement>('[data-copy-markdown]').forEach((button) => {
  const textSpan = button.querySelector<HTMLElement>('.btn-text');
  const defaultLabel = textSpan?.textContent || '';
  let timeoutId: ReturnType<typeof setTimeout> | null = null;

  button.addEventListener('click', async () => {
    const isFr = document.documentElement.lang === 'fr';
    try {
      const response = await fetch(button.dataset.markdownPath || '');
      if (!response.ok) throw new Error();
      await navigator.clipboard.writeText(await response.text());
      button.classList.add('is-copied');
      button.classList.remove('is-error');
      if (textSpan) {
        textSpan.textContent = isFr ? 'Markdown copié !' : 'Markdown copied!';
      }
      if (timeoutId) clearTimeout(timeoutId);
      timeoutId = setTimeout(() => {
        button.classList.remove('is-copied');
        if (textSpan) textSpan.textContent = defaultLabel;
      }, 2400);
    } catch {
      button.classList.add('is-error');
      button.classList.remove('is-copied');
      if (textSpan) {
        textSpan.textContent = isFr ? 'Échec de la copie' : 'Copy failed';
      }
      if (timeoutId) clearTimeout(timeoutId);
      timeoutId = setTimeout(() => {
        button.classList.remove('is-error');
        if (textSpan) textSpan.textContent = defaultLabel;
      }, 2600);
    }
  });
});
</script>

<style>
.page-actions {
  display: inline-flex;
  align-items: center;
  margin-top: 0.8rem;
}
.copy-button {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 36px;
  padding: 0.4rem 0.85rem;
  border: 1px solid var(--ug-line);
  border-radius: var(--ug-radius-sm);
  background: var(--ug-paper-raised);
  color: var(--ug-graphite);
  font: 600 0.78rem var(--ug-font-sans);
  cursor: pointer;
  transition: all 0.16s var(--ug-ease-out);
}
.copy-button:hover {
  border-color: var(--ug-violet);
  color: var(--ug-violet-strong);
  background: color-mix(in srgb, var(--ug-violet) 6%, var(--ug-paper-raised));
}
.copy-button:active {
  transform: translateY(1px);
}
.copy-button .check-icon {
  display: none;
  color: #10b981;
}
.copy-button.is-copied {
  border-color: #10b981;
  background: color-mix(in srgb, #10b981 10%, var(--ug-paper-raised));
  color: #059669;
}
:root[data-theme="dark"] .copy-button.is-copied {
  color: #34d399;
}
.copy-button.is-copied .copy-icon {
  display: none;
}
.copy-button.is-copied .check-icon {
  display: inline-block;
}
.copy-button.is-error {
  border-color: var(--ug-coral);
  color: var(--ug-coral);
}
</style>
