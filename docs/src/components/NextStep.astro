---
interface Props {
  href: string;
  label?: string;
  title: string;
}
const { href, label = 'Next step', title } = Astro.props;
---

<a class="next-step" href={href}
  ><small>{label}</small><strong>{title}</strong><span aria-hidden="true">→</span></a
>
<style>
.next-step {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.25rem 1rem;
  margin: 2rem 0;
  padding: 1rem 0;
  border-block: var(--ug-border);
  color: var(--ug-graphite);
  text-decoration: none;
}
.next-step small {
  grid-column: 1;
  color: var(--ug-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.next-step strong {
  grid-column: 1;
}
.next-step span {
  grid-column: 2;
  grid-row: 1 / 3;
  align-self: center;
  color: var(--ug-violet);
  font-size: 1.5rem;
}
.next-step:hover strong {
  color: var(--ug-violet-strong);
}
</style>
